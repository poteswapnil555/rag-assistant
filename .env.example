# Fake placeholder values only. Copy to .env (never commit .env).

# LLM option 1: any OpenAI-compatible endpoint
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your-model-name

# LLM option 2: Azure OpenAI with an API key
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-api-key-here
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-06-01
# Azure OpenAI sign-in mode: leave AZURE_OPENAI_API_KEY unset and set these instead
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# Retrieval (all optional)
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SIMILARITY_THRESHOLD=0.35
# TOP_K=4
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150

# Limits (optional)
# LLM_TIMEOUT_SECONDS=60
# MAX_FILE_MB=50
# MAX_QUESTION_CHARS=1000
